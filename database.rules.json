{
  "rules": {
    ".read": false,
    ".write": false,
    "mesa": {
      "$sala": {
        ".read": "$sala.length >= 16",
        ".write": "$sala.length >= 16",
        "now": {
          ".validate": "newData.hasChildren(['idx','by','at']) && newData.child('idx').isNumber() && newData.child('idx').val() >= 0 && newData.child('idx').val() < 100"
        },
        "chat": {
          "$m": {
            ".validate": "newData.hasChildren(['text','role','at']) && newData.child('text').isString() && newData.child('text').val().length <= 500 && newData.child('role').isString() && newData.child('role').val().length <= 20"
          }
        },
        "tela": {
          ".validate": "newData.hasChildren(['ov','at']) && newData.child('ov').isString() && newData.child('ov').val().length <= 30 && newData.child('at').isNumber()"
        },
        "ros": {
          ".validate": "newData.hasChildren(['lista','at']) && newData.child('lista').isString() && newData.child('lista').val().length <= 30000"
        },
        "$outro": {
          ".validate": false
        }
      }
    },
    "ver": {
      "$v": {
        ".read": "$v.length >= 16",
        ".write": "$v.length >= 16",
        "now": {
          ".validate": "newData.hasChildren(['idx','by','at']) && newData.child('idx').isNumber() && newData.child('idx').val() >= 0 && newData.child('idx').val() < 100"
        },
        "ros": {
          ".validate": "newData.hasChildren(['lista','at']) && newData.child('lista').isString() && newData.child('lista').val().length <= 30000"
        },
        "tela": {
          ".validate": "newData.hasChildren(['ov','at']) && newData.child('ov').isString() && newData.child('ov').val().length <= 30 && newData.child('at').isNumber()"
        },
        "$outro": {
          ".validate": false
        }
      }
    },
    "cred": {
      "$sala": {
        ".read": "$sala.length >= 16",
        "p": {
          "$id": {
            ".write": "$sala.length >= 16 && newData.exists()",
            ".validate": "newData.hasChildren(['n']) && newData.child('n').isString() && newData.child('n').val().length <= 200"
          }
        },
        "ci": {
          "$id": {
            ".write": "$sala.length >= 16 && (!data.exists() || !newData.exists())",
            ".validate": "newData.hasChildren(['at','by','bn']) && newData.child('at').isNumber() && newData.child('bn').isString() && newData.child('bn').val().length <= 80 && newData.parent().parent().child('p').child($id).exists()"
          }
        },
        "staff": {
          "$dev": {
            ".write": "$sala.length >= 16",
            ".validate": "newData.hasChildren(['n']) && newData.child('n').isString() && newData.child('n').val().length <= 80"
          }
        },
        "log": {
          "$k": {
            ".write": "$sala.length >= 16 && !data.exists()",
            ".validate": "newData.hasChildren(['a','at'])"
          }
        },
        "$outro": {
          ".validate": false
        }
      }
    }
  }
}